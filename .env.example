# ── Stripe Keys ───────────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── After running `node setup-stripe.js`, paste the Price IDs here ────────────
STRIPE_PRICE_COMPLETE_SET=price_...
STRIPE_PRICE_EXTRA_BAGS=price_...
STRIPE_PRICE_MERCH=price_...

# ── Webhook secret (from `stripe listen` or Stripe Dashboard) ─────────────────
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Your site's base URL ──────────────────────────────────────────────────────
DOMAIN=http://localhost:3000

# ── Live stock tracking (Complete Set) ─────────────────────────────────────────
# COMPLETE_SET_STOCK_LIMIT: how many sets are available in the current batch.
# COMPLETE_SET_STOCK_BATCH: bump this (e.g. "2", "3"...) whenever new stock
#   comes in so past sales don't count against the new batch. Both are
#   read live by the server — update them in Render's environment variables
#   and redeploy; no code changes needed to restock.
COMPLETE_SET_STOCK_LIMIT=1
COMPLETE_SET_STOCK_BATCH=1
